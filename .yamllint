---
extends: default
rules:
  line-length: {max: 160}
  truthy: {allowed-values: ["true", "false"]}
  comments: {min-spaces-from-content: 1}
  comments-indentation: false
  braces: {max-spaces-inside: 1}
  document-start: disable
octal-values:
  forbid-implicit-octal: true
  forbid-explicit-octal: true
